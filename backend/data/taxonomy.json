  "bridges": [
    {
      "from": "react",
      "to": "vue",
      "weeks": 1.0,
      "note": "Same component model, same reactivity idea, different template syntax."
    },
    {
      "from": "vue",
      "to": "react",
      "weeks": 1.0,
      "note": "Same component model; JSX replaces the template block."
    },
    {
      "from": "react",
      "to": "svelte",
      "weeks": 1.0,
      "note": "Component thinking transfers; the compiler removes the hook rules."
    },
    {
      "from": "react",
      "to": "angular",
      "weeks": 3.0,
      "note": "Component thinking transfers, but DI, RxJS and decorators are new."
    },
    {
      "from": "python",
      "to": "node.js",
      "weeks": 2.5,
      "note": "Language is familiar ground; the event loop and async I/O model are not."
    },
    {
      "from": "java",
      "to": "node.js",
      "weeks": 3.0,
      "note": "Server concepts transfer; dynamic typing and the event loop are the adjustment."
    },
    {
      "from": "python",
      "to": "go",
      "weeks": 3.0,
      "note": "Static types, explicit error handling and goroutines are genuinely new."
    },
    {
      "from": "mysql",
      "to": "postgresql",
      "weeks": 0.5,
      "note": "Same relational model and near-identical SQL surface."
    },
    {
      "from": "docker",
      "to": "kubernetes",
      "weeks": 4.0,
      "note": "Containers are the prerequisite, not the skill - scheduling is the new part."
    },
    {
      "from": "javascript",
      "to": "typescript",
      "weeks": 1.5,
      "note": "Same runtime; the work is learning the type system, not the language."
    },
    {
      "from": "express",
      "to": "fastapi",
      "weeks": 1.5,
      "note": "Identical routing and middleware concepts in a different language."
    },
    {
      "from": "flask",
      "to": "fastapi",
      "weeks": 0.5,
      "note": "Same WSGI-era mental model plus type hints and async."
    },
    {
      "from": "rest api",
      "to": "graphql",
      "weeks": 2.0,
      "note": "API thinking transfers; the schema-and-resolver model is the new part."
    }
  ]
}
